DATABASE_URL=postgres://postgres:postgres@localhost:5432/rentbox_ai_employee

# required for admin APIs/pages
ADMIN_API_KEY=dev-admin-key

# widget + APIs will accept origin from rentbox.ee (optional)
ALLOWED_WIDGET_ORIGINS=https://rentbox.ee,http://localhost:3000

# outbound providers (optional)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@rentbox.ee
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: orchestrator LLM (kept optional; heuristic routing works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Safety + throttling
OUTBOUND_RATE_LIMIT_PER_HOUR=5

