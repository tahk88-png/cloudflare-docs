---
import LocalBusinessSchema from "~/components/seo/LocalBusinessSchema.astro";
import FAQSchema from "~/components/seo/FAQSchema.astro";
import LocalTrustSignals from "~/components/conversion/LocalTrustSignals.astro";
import PricingBlock from "~/components/conversion/PricingBlock.astro";

interface Props {
	params: Promise<{ location: string }>;
}

const { location } = await Astro.params;

// Parse location from slug (e.g., "new-york" -> "New York")
const locationName = location
	.split("-")
	.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
	.join(" ");

const title = `Cloudflare Services in ${locationName}`;
const description = `Cloudflare services and solutions available in ${locationName}. Enterprise-grade CDN, security, and performance optimization.`;

// Mock address data - in production, this would come from a database
const address = {
	addressLocality: locationName,
	addressCountry: "US",
};

const faqs = [
	{
		question: `Does Cloudflare have a presence in ${locationName}?`,
		answer: `Yes, Cloudflare has a global network with edge locations worldwide, including coverage in ${locationName} and surrounding areas.`,
	},
	{
		question: `What services are available in ${locationName}?`,
		answer: `Cloudflare offers CDN, DDoS protection, Web Application Firewall, SSL/TLS encryption, and other services in ${locationName} through our global network.`,
	},
	{
		question: `How can I get started with Cloudflare in ${locationName}?`,
		answer: `Getting started is easy! Sign up for a free account and your services will automatically be available through our edge network in ${locationName}.`,
	},
	{
		question: `What are the benefits of using Cloudflare in ${locationName}?`,
		answer: `Cloudflare's edge network in ${locationName} provides low latency, improved performance, and enhanced security for your applications and websites.`,
	},
];
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | Cloudflare</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url.href} />
		<LocalBusinessSchema
			name={`Cloudflare - ${locationName}`}
			address={address}
			telephone="+1-650-319-8930"
			geo={{
				latitude: "37.7749",
				longitude: "-122.4194",
			}}
		/>
		<FAQSchema faqs={faqs} />
	</head>
	<body>
		<main class="container mx-auto px-4 py-12 max-w-6xl">
			<article>
				<header class="mb-8">
					<h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
						{title}
					</h1>
					<p class="text-xl text-gray-600 dark:text-gray-400">{description}</p>
				</header>

				<div class="mb-12">
					<LocalTrustSignals location={locationName} />
				</div>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
						Why Choose Cloudflare in {locationName}?
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						<div class="p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
								Low Latency
							</h3>
							<p class="text-gray-600 dark:text-gray-400">
								Edge locations in {locationName} ensure fast content delivery
								to your users.
							</p>
						</div>
						<div class="p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
								Enhanced Security
							</h3>
							<p class="text-gray-600 dark:text-gray-400">
								Protect your applications with enterprise-grade security
								features.
							</p>
						</div>
						<div class="p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
								24/7 Support
							</h3>
							<p class="text-gray-600 dark:text-gray-400">
								Round-the-clock support for businesses in {locationName} and
								worldwide.
							</p>
						</div>
					</div>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
						Pricing Plans
					</h2>
					<PricingBlock />
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
						Frequently Asked Questions
					</h2>
					<div class="space-y-4">
						{faqs.map((faq) => (
							<details class="p-4 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
								<summary class="font-semibold text-gray-900 dark:text-white cursor-pointer">
									{faq.question}
								</summary>
								<p class="mt-2 text-gray-600 dark:text-gray-400">
									{faq.answer}
								</p>
							</details>
						))}
					</div>
				</section>
			</article>
		</main>
	</body>
</html>
