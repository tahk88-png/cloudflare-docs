---
import { SigningConsent } from '~/components/checkout/SigningConsent';
import { Payment } from '~/components/checkout/Payment';

interface Props {
	cart_id: string;
}

const { cart_id } = Astro.params;

// In production, fetch cart info from your backend
// For now, using mock data
const cartInfo = {
	cart_id: cart_id || '',
	total_amount: 150, // EUR
	rental_duration_hours: 48,
	is_b2b: false,
	customer_email: 'customer@example.com',
	customer_phone: '+372 12345678',
};
---

<html lang="et">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Rentbox.ee - Kassa</title>
		<style>
			body {
				font-family: system-ui, -apple-system, sans-serif;
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
		</style>
	</head>
	<body>
		<div id="checkout-root">
			<h1>Tellimuse kokkuvõte</h1>
			<div class="order-summary">
				<p>Tellimuse ID: {cart_id}</p>
				<p>Kogusumma: {cartInfo.total_amount} EUR</p>
				<p>Rendiperiood: {cartInfo.rental_duration_hours} tundi</p>
			</div>

			<SigningConsent
				client:load
				cartId={cart_id || ''}
				cartInfo={cartInfo}
				onSigningComplete={async (consent) => {
					// Verify checkout can proceed - payment component will handle enabling itself
					console.log('Signing complete:', consent);
				}}
			/>

			<Payment
				client:load
				cartId={cart_id || ''}
				cartInfo={cartInfo}
				onPaymentSuccess={(bookingId, accessCode) => {
					// Show success message and redirect
					const successDiv = document.createElement('div');
					successDiv.className = 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded text-sm mt-4';
					successDiv.innerHTML = `
						<div class="font-medium mb-1">Makse õnnestus!</div>
						<div>Broneering ID: ${bookingId}</div>
						<div>Ligipääsukood: ${accessCode}</div>
						<div class="mt-2 text-xs">Ligipääsukood saadetud SMS-iga.</div>
					`;
					document.getElementById('checkout-root')?.appendChild(successDiv);
					
					// Scroll to success message
					successDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}}
				onPaymentError={(error) => {
					console.error('Payment error:', error);
				}}
			/>
		</div>
	</body>
</html>
