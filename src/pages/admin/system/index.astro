---
// Admin System Management Page
import { FeatureFlagsPanel } from "../../components/admin/FeatureFlagsPanel";
import { MaintenanceModePanel } from "../../components/admin/MaintenanceModePanel";
import { AuditLogPanel } from "../../components/admin/AuditLogPanel";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>System Management - Rentbox v2</title>
		<style>
			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
				margin: 0;
				padding: 20px;
				background-color: #f5f5f5;
			}
		</style>
	</head>
	<body>
		<div style="max-width: 1200px; margin: 0 auto;">
			<header style="margin-bottom: 30px;">
				<h1 style="font-size: 2rem; font-weight: bold; margin-bottom: 10px;">
					System Management
				</h1>
				<p style="color: #666;">
					Manage feature flags, maintenance mode, and view audit logs
				</p>
			</header>

			<div style="display: grid; gap: 24px;">
				<main>
					<div style="display: grid; gap: 24px;">
						<div>
							<FeatureFlagsPanel
								client:load
								apiBaseUrl="/api"
								authToken={Astro.cookies.get("auth_token")?.value}
								userId={Astro.cookies.get("user_id")?.value}
								userEmail={Astro.cookies.get("user_email")?.value}
							/>
						</div>

						<div>
							<MaintenanceModePanel
								client:load
								apiBaseUrl="/api"
								authToken={Astro.cookies.get("auth_token")?.value}
								userId={Astro.cookies.get("user_id")?.value}
								userEmail={Astro.cookies.get("user_email")?.value}
							/>
						</div>

						<div>
							<AuditLogPanel
								client:load
								apiBaseUrl="/api"
								authToken={Astro.cookies.get("auth_token")?.value}
								limit={50}
							/>
						</div>
					</div>
				</main>
			</div>
		</div>
	</body>
</html>
