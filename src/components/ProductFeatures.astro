---
import { z } from "astro:schema";
import { marked } from "marked";
import { indexPlans } from "~/util/plans";
import type { PlanCategory, Feature, FeatureProperty } from "~/util/planTypes";

type Props = z.infer<typeof props>;

const props = z
	.object({
		id: z.string(),
		additional_descriptions: z.boolean().optional(),
	})
	.strict();

const { id, additional_descriptions } = props.parse(Astro.props);

const plan = (await indexPlans(id)) as PlanCategory;

const entries = Object.entries(plan);
---

{
	entries.map(([key, value]: [string, Feature | string | Record<string, FeatureProperty> | undefined]) => {
		if (key === "title" || key === "link") return;

		return (
			<div>
				<h3>{value.title}</h3>
				{value.link && (
					<p>
						<!-- prettier-ignore -->
						<strong>Link:</strong>{" "}<a href={value.link}>{value.title}</a>
					</p>
				)}
				{Object.values(value.properties).map((featureProp: FeatureProperty) => (
					<div>
						<strong
							set:html={marked.parseInline(
								featureProp.title === "Availability"
									? "Feature availability"
									: featureProp.title,
							)}
						/>
						{featureProp.title !== "Availability" && featureProp.summary && (
							<Fragment set:html={marked.parse(featureProp.summary)} />
						)}
						<ul>
							{featureProp.free !== undefined && (
								<li>
									<strong>Free:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(featureProp.free.toString())}
									/>
								</li>
							)}
							{additional_descriptions && (
								<>
									{featureProp.lite !== undefined ? (
										<li>
											<strong>Lite:</strong>{" "}
											<Fragment
												set:html={marked.parseInline(featureProp.lite.toString())}
											/>
										</li>
									) : (
										featureProp.free !== undefined && (
											<li>
												<strong>Lite:</strong>{" "}
												<Fragment
													set:html={marked.parseInline(featureProp.free.toString())}
												/>
											</li>
										)
									)}
								</>
							)}
							{featureProp.pro !== undefined && (
								<li>
									<strong>Pro:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(featureProp.pro.toString())}
									/>
								</li>
							)}
							{additional_descriptions && (
								<>
									{featureProp.pro_plus !== undefined ? (
										<li>
											<strong>Pro Plus:</strong>{" "}
											<Fragment
												set:html={marked.parseInline(featureProp.pro_plus.toString())}
											/>
										</li>
									) : (
										featureProp.pro !== undefined && (
											<li>
												<strong>Pro Plus:</strong>{" "}
												<Fragment
													set:html={marked.parseInline(featureProp.pro.toString())}
												/>
											</li>
										)
									)}
								</>
							)}
							{featureProp.biz !== undefined && (
								<li>
									<strong>Business:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(featureProp.biz.toString())}
									/>
								</li>
							)}
							{featureProp.ent !== undefined && (
								<li>
									<strong>Enterprise:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(featureProp.ent.toString())}
									/>
								</li>
							)}
						</ul>
					</div>
				))}
			</div>
		);
	})
}
