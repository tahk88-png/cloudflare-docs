---
import { z } from "astro:schema";
import { marked } from "marked";
import {
	getPlanCategoryFeatures,
	type PlanFeature,
	type PlanFeatureProperty,
	indexPlans,
} from "~/util/plans";

type Props = z.infer<typeof props>;

const props = z
	.object({
		id: z.string(),
		additional_descriptions: z.boolean().optional(),
	})
	.strict();

const { id, additional_descriptions } = props.parse(Astro.props);

const plan = await indexPlans(id);

const entries = getPlanCategoryFeatures(plan);

if (entries.length === 0) {
	throw new Error(`[ProductFeatures] No features found for plans id "${id}".`);
}
---

{
	entries.map(([, feature]: [string, PlanFeature]) => {
		const properties = Object.values(feature.properties) as PlanFeatureProperty[];

		return (
			<div>
				<h3>{feature.title}</h3>
				{feature.link && (
					<p>
						<!-- prettier-ignore -->
						<strong>Link:</strong>{" "}<a href={feature.link}>{feature.title}</a>
					</p>
				)}
				{properties.map((value) => (
					<div>
						<strong
							set:html={marked.parseInline(
								value.title === "Availability"
									? "Feature availability"
									: value.title,
							)}
						/>
						{value.title !== "Availability" && value.summary && (
							<Fragment set:html={marked.parse(value.summary)} />
						)}
						<ul>
							{value.free !== undefined && (
								<li>
									<strong>Free:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(value.free.toString())}
									/>
								</li>
							)}
							{additional_descriptions && (
								<>
									{value.lite !== undefined ? (
										<li>
											<strong>Lite:</strong>{" "}
											<Fragment
												set:html={marked.parseInline(value.lite.toString())}
											/>
										</li>
									) : (
										value.free !== undefined && (
											<li>
												<strong>Lite:</strong>{" "}
												<Fragment
													set:html={marked.parseInline(value.free.toString())}
												/>
											</li>
										)
									)}
								</>
							)}
							{value.pro !== undefined && (
								<li>
									<strong>Pro:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(value.pro.toString())}
									/>
								</li>
							)}
							{additional_descriptions && (
								<>
									{value.pro_plus !== undefined ? (
										<li>
											<strong>Pro Plus:</strong>{" "}
											<Fragment
												set:html={marked.parseInline(value.pro_plus.toString())}
											/>
										</li>
									) : (
										value.pro !== undefined && (
											<li>
												<strong>Pro Plus:</strong>{" "}
												<Fragment
													set:html={marked.parseInline(value.pro.toString())}
												/>
											</li>
										)
									)}
								</>
							)}
							{value.biz !== undefined && (
								<li>
									<strong>Business:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(value.biz.toString())}
									/>
								</li>
							)}
							{value.ent !== undefined && (
								<li>
									<strong>Enterprise:</strong>{" "}
									<Fragment
										set:html={marked.parseInline(value.ent.toString())}
									/>
								</li>
							)}
						</ul>
					</div>
				))}
			</div>
		);
	})
}
