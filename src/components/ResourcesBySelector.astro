---
import { z } from "astro:schema";
import { getCollection, type CollectionEntry } from "astro:content";
import ResourcesBySelectorReact from "./ResourcesBySelector";

type Props = z.input<typeof props>;

type DocsData = keyof CollectionEntry<"docs">["data"];
type VideosData = keyof CollectionEntry<"stream">["data"];

type ResourcesData = DocsData | VideosData;

const props = z.object({
	tags: z.string().array().optional(),
	types: z.string().array(),
	products: z.string().array().optional(),
	directory: z.string().optional(),
	filterables: z.custom<ResourcesData>().array().optional(),
	columns: z.union([z.literal(2), z.literal(3)]).default(2),
	showDescriptions: z.boolean().default(true),
	showLastUpdated: z.boolean().default(false),
});

type MinimalResource = {
	id: string;
	href: string;
	title: string;
	description?: string;
	updated?: string;
	filterableValues?: string[];
};

const {
	tags,
	types,
	products,
	directory,
	filterables,
	columns,
	showDescriptions,
	showLastUpdated,
} = props.parse(Astro.props);

const docs = await getCollection("docs");
const videos = await getCollection("stream");

const matchingEntries: Array<CollectionEntry<"docs"> | CollectionEntry<"stream">> = [
	...docs,
	...videos,
].filter(({ id, collection, data }) => {
	const type = "pcx_content_type" in data ? data.pcx_content_type : collection;
	return (
		types.includes(type ?? "") &&
		(directory ? id.startsWith(directory) : true) &&
		(tags ? data.tags?.some((v: string) => tags.includes(v)) : true) &&
		(products
			? data.products?.some((v) =>
					products.includes(typeof v === "object" ? v.id : v),
				)
			: true)
	);
});

const facets = matchingEntries.reduce(
	(acc, page) => {
		if (!filterables) return acc;

		for (const filter of filterables) {
			const val = page.data[filter as keyof typeof page.data];
			if (val) {
				if (Array.isArray(val) && val.every((v) => typeof v === "string")) {
					acc[filter] = [...new Set([...(acc[filter] || []), ...val])];
				} else if (typeof val === "string") {
					acc[filter] = [...new Set([...(acc[filter] || []), val])];
				}
			}
		}

		return acc;
	},
	{} as Record<string, string[]>,
);

function getDocsTitle(entry: CollectionEntry<"docs">): string {
	const titleItem = entry.data.head.find((item) => item.tag === "title");
	return titleItem ? titleItem.content : entry.data.title;
}

function getHref(entry: CollectionEntry<"docs"> | CollectionEntry<"stream">): string {
	return entry.collection === "stream"
		? `/videos/${entry.data.url}/`
		: `/${entry.id}/`;
}

function getFilterableValues(
	entry: CollectionEntry<"docs"> | CollectionEntry<"stream">,
): string[] | undefined {
	if (!filterables) return undefined;

	const values: string[] = [];
	for (const filter of filterables) {
		const val = entry.data[filter as keyof typeof entry.data];
		if (!val) continue;

		if (Array.isArray(val) && val.every((v) => typeof v === "string")) {
			values.push(...val);
		} else if (typeof val === "string") {
			values.push(val);
		}
	}

	// De-dup to avoid bloating serialized props.
	return [...new Set(values)];
}

const resources: MinimalResource[] = matchingEntries.map((entry) => ({
	id: entry.id,
	href: getHref(entry),
	title: entry.collection === "docs" ? getDocsTitle(entry) : entry.data.title,
	description: entry.data.description,
	updated:
		entry.data.updated instanceof Date ? entry.data.updated.toISOString() : undefined,
	filterableValues: getFilterableValues(entry),
}));
---

<div>
	<ResourcesBySelectorReact
		resources={resources}
		facets={facets}
		filters={filterables}
		columns={columns}
		showDescriptions={showDescriptions}
		showLastUpdated={showLastUpdated}
		client:visible
	/>
</div>
