---
import { z } from "astro:schema";
import {
	indexPlans,
	isPlanFeature,
	type PlanCellValue,
	type PlanFeature,
	type PlanFeatureProperty,
} from "~/util/plans";
import { marked } from "marked";

type Props = z.infer<typeof props>;

const props = z
	.object({
		id: z.string(),
	})
	.strict();

const { id } = props.parse(Astro.props);

const planUnknown = await indexPlans(id);

if (!isPlanFeature(planUnknown)) {
	throw new Error(`[FeatureTable] Plans id "${id}" did not resolve to a feature.`);
}

const plan = planUnknown as PlanFeature;

const features = Object.values(plan.properties) as PlanFeatureProperty[];

const hasFree = features.some((x) => x.free !== undefined);
const hasPro = features.some((x) => x.pro !== undefined);
const hasBiz = features.some((x) => x.biz !== undefined);
const hasEnt = features.some((x) => x.ent !== undefined);
const hasEntPlus = features.some((x) => x.ent_plus !== undefined);

const markdown = (content: PlanCellValue | undefined) => {
	if (content === undefined) return "";
	return marked.parse(typeof content === "string" ? content : String(content));
};
---

<table>
	<thead>
		<tr>
			<th></th>
			{hasFree && <th>Free</th>}
			{hasPro && <th>Pro</th>}
			{hasBiz && <th>Business</th>}
			{hasEnt && <th>Enterprise</th>}
			{hasEntPlus && <th>{plan.ent_plus ?? "Enterprise+"}</th>}
		</tr>
	</thead>
	<tbody>
		{
			features.map((feature) => {
				return (
					<tr>
						<th set:html={markdown(feature.title)} />
						{hasFree && <td set:html={markdown(feature.free)} />}
						{hasPro && <td set:html={markdown(feature.pro)} />}
						{hasBiz && <td set:html={markdown(feature.biz)} />}
						{hasEnt && <td set:html={markdown(feature.ent)} />}
						{hasEntPlus && <td set:html={markdown(feature.ent_plus)} />}
					</tr>
				);
			})
		}
	</tbody>
</table>
