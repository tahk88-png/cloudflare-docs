{
	"name": "invoicing-system",
	"version": "1.0.0",
	"description": "Production-grade invoicing system with PDF generation and email delivery",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"migrate": "wrangler d1 execute invoicing-db --file=./migrations/0001_initial.sql",
