{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ESNext",
		"paths": {
			"~/*": ["src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["@cloudflare/workers-types"]
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "worker"]
}
