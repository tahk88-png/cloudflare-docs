// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPPORT
  OPS
  SALES
  ADMIN
  MAINTENANCE
  OWNER
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  READY_FOR_PICKUP
  PICKED_UP
  IN_USE
  RETURN_DUE
  RETURNED
  COMPLETED
  CANCELLED
  OVERDUE
  DISPUTE
  MAINTENANCE_HOLD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSender {
  USER
  AI
  AGENT
  SYSTEM
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  role      Role     @default(CUSTOMER)
  language  String   @default("et") // Preference: et, en, ru
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  tickets   Ticket[]
  feedback  Feedback[]
}

model Product {
  id                  String   @id @default(uuid())
  name                String
  price               Decimal
  assetValue          Decimal? // V2
  rentalCount         Int      @default(0)
  lastMaintenanceDate DateTime @default(now())
  externalId          String?  @unique
  
  bookings        Booking[]
  maintenanceLogs MaintenanceLog[]
}

model Locker {
  id           String        @id @default(uuid())
  location     String
  apiKey       String?       
  reliability  Int           @default(100) // 0-100 score
  externalId   String?       @unique
  compartments Compartment[]
}

model Compartment {
  id              String   @id @default(uuid())
  lockerId        String
  size            String   // S, M, L
  status          String   // available, occupied, maintenance
  openFailedCount Int      @default(0)
  
  locker          Locker   @relation(fields: [lockerId], references: [id])
  bookings        Booking[]
  maintenanceLogs MaintenanceLog[]
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  productId     String
  compartmentId String
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  riskScore     Int           @default(0) // 0-100
  riskFlags     Json?         // V2: Details on why risk is high
  externalSource String       @default("rentster")
  externalId    String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  compartment Compartment @relation(fields: [compartmentId], references: [id])
  
  payments    Payment[]
  messages    Message[]
  tickets     Ticket[]
  events      Event[]
  aiActions   AiAction[]
  feedback    Feedback?
}

model Payment {
  id         String        @id @default(uuid())
  bookingId  String
  amount     Decimal
  status     PaymentStatus
  externalId String?
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

model Event {
  id        String   @id @default(uuid())
  type      String   // webhook.payment, locker.opened, cron.reminder, etc.
  payload   Json
  status    String   // pending, processed, failed
  bookingId String?
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
}

model Message {
  id        String        @id @default(uuid())
  bookingId String
  sender    MessageSender
  content   String
  role      Role?         // If sender is AI, which agent role handled it?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

model AiAction {
  id        String   @id @default(uuid())
  bookingId String?
  type      String   // email, sms, ticket, log, tool_call
  agentRole Role?    // Which agent performed this
  reason    String
  outcome   String
  toolCalls Json?    // Arguments used if tool was called
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
}

model Ticket {
  id          String         @id @default(uuid())
  bookingId   String?
  userId      String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  description String
  assignedTo  Role?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
}

model MaintenanceLog {
  id            String   @id @default(uuid())
  productId     String?
  compartmentId String?
  issueType     String   // battery, noise, lock, etc.
  description   String
  status        String   // open, resolved
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  product     Product?     @relation(fields: [productId], references: [id])
  compartment Compartment? @relation(fields: [compartmentId], references: [id])
}

model Feedback {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}
