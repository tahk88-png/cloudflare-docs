{
  "name": "rentbox-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "worker": "tsx worker/index.ts",
    "db:migrate": "psql $DATABASE_URL -f database/schema.sql",
